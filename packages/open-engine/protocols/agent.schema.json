{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudentBuddy Agent definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "apiVersion", "id", "revision", "name", "instructions", "capabilities", "workflow"],
  "properties": {
    "schema": { "const": "studentbuddy.agent" },
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "instructions": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "capabilities": { "type": "array", "uniqueItems": true, "maxItems": 4, "items": { "enum": ["world.inspect", "world.preview", "content.inspect", "ability.recall"] } },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["onQuestion", "reviewStyle", "steps"],
      "properties": {
        "onQuestion": { "enum": ["hint-first", "ask-first"] },
        "reviewStyle": { "enum": ["concise", "socratic"] },
        "steps": { "type": "array", "maxItems": 8, "items": { "enum": ["world.inspect", "world.preview", "content.inspect", "ability.recall"] } }
      }
    }
  },
  "$comment": "Runtime additionally checks host grants, workflow capability references, revision chains and user approval. Text is data, never executable code."
}
